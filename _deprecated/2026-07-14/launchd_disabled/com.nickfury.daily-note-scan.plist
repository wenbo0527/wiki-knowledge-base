<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/wenbo</string>
		<key>OPENCLAW_HOME</key>
		<string>/Users/wenbo/.openclaw</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.nickfury.daily-note-scan</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/wenbo/.openclaw/workspace/agents/nick_fury/scripts/daily_note_scan.py</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/wenbo/.openclaw/workspace/agents/nick_fury/logs/daily_scan.err</string>
	<key>StandardOutPath</key>
	<string>/Users/wenbo/.openclaw/workspace/agents/nick_fury/logs/daily_scan.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>21</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>UMASK</key>
	<integer>22</integer>
	<key>UserName</key>
	<string>wenbo</string>
</dict>
</plist>
